msgid ""
"You caught a Phish! It is a ${ FISH_TYPES[type].name } with ${ size }kg! As "
"a bonus, your cooldown is reduced."
msgstr ""
"Je hebt een Phish gevangen! Het is een ${ FISH_TYPES[type].name } met ${ "
"size }kg! Als bonus wordt je cooldown verkort."


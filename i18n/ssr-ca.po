msgstr "No pots elevar el nivell de poder d'un rol al teu"

#, javascript-format
msgid "Can not have more than ${ MAX_ROLES_PER_FACTION } faction roles"
msgstr "No es poden tenir més de ${ MAX_ROLES_PER_FACTION } rols de facció"

msgid "Can not have more than 20 invites per faction"
msgstr "No es poden tenir més de 20 invitacions per facció"

msgid "Can not modify user equal to you or above you"
msgstr "No pots modificar un usuari igual o superior a tu"

#. when leaving a faction and you are the last owner
msgid "Can not orphan a faction"
msgstr "No es pot deixar una facció orfe"

#, javascript-format
msgid ""
"Can not upload this many files at once, only 5 are allowed, you have $"
"{ amountOfFiles }"
msgstr ""
"No es poden pujar tants fitxers alhora, només se'n permeten 5, tens ${ "
"amountOfFiles }"

msgid "Can only have one Sovereign role"
msgstr "Només es pot tenir un rol Sobirà"


msgstr "Emri i përdoruesit nuk mund të fillojë me pp_"

msgid "Username can only contain the characters: a-z . _ and -"
msgstr "Emri i përdoruesit mund të përmbajë vetëm karakteret: a-z . _ dhe -"

msgid "Username can't be empty."
msgstr "Emri i përdoruesit nuk mund të jetë bosh."

msgid "Username must be at least 2 characters long"
msgstr "Emri i përdoruesit duhet të jetë të paktën 2 karaktere i gjatë"

msgid "Username must be shorter than 26 characters"
msgstr "Emri i përdoruesit duhet të jetë më i shkurtër se 26 karaktere"

msgid ""
"We already sent you a mail with instructions. Please wait before requesting "
"another mail."
msgstr ""
"Ne ju kemi dërguar një email me udhëzime. Ju lutemi prisni para se të "
"kërkoni një email tjetër."

#, javascript-format
msgid ""
"We already sent you a verification mail, you can request another one in $"
"{ minLeft } minutes."
msgstr ""
"Ne ju kemi dërguar një email verifikimi, ju mund të kërkoni një tjetër pas $"
"{ minLeft } minutash."

msgid "We currently do not allow file uploads"
msgstr "Ngarkimi i skedarëve nuk lejohet për momentin"

#, javascript-format
msgid "Welcome ${ name } to PixelPlanet, please verify your mail"
msgstr ""
"Mirë se vini ${ name } në PixelPlanet, ju lutemi verifikoni emailin tuaj"

msgid "You already chose your username"
msgstr "Ju tashmë keni zgjedhur emrin tuaj të përdoruesit"

msgid "You already have that name."
msgstr "Tashmë e keni këtë emër."

msgid "You are already part of this faction"
msgstr "Ti tashmë je pjesëtar i ktij fraksioni"

msgid "You are already verified."
msgstr "Ju tashmë jeni verifikuar."

msgid "You are banned from this faction"
msgstr "Ti je dëbuar nga ky fraksion"

#, javascript-format
msgid "You are muted for another ${ timeMin } minutes"
msgstr "Ju jeni të heshtur për ${ timeMin } minuta të tjera"

#, javascript-format
msgid "You are muted for another ${ ttl } seconds"
msgstr "Ju jeni të heshtur për ${ ttl } sekonda të tjera"

msgid "You are not allowed to access this page"
msgstr "Ju nuk lejohet të hyni në këtë faqe"

msgid "You are not banned"
msgstr "Ju nuk jeni të dëbuar"

msgid "You are not logged in"
msgstr "Ju nuk jeni të regjistruar"

msgid "You are now verified :)"
msgstr "Ju jeni verifikuar tani :)"

msgid "You are permanently muted, join our guilded to appeal the mute"
msgstr ""
"Ju jeni të heshtur përgjithmonë, bashkohuni në komunitetin tonë për të "
"apeluar heshtjen"

#, javascript-format
msgid "You are sending messages too fast, you have to wait ${ waitTime }s :("
msgstr ""
"Ju po dërgoni mesazhe shumë shpejt, duhet të prisni ${ waitTime } sekonda :("

msgid "You attached too many files"
msgstr "Ju bashkangjitët shumë skedarë"

msgid ""
"You can not delete this login method, because you have nothing else left."
msgstr ""
"Ju nuk mund të fshini këtë metodë hyrjeje, sepse nuk keni asgjë tjetër."

msgid "You can not register an account while you are banned"
msgstr "Ju nuk mund të regjistroni një llogari ndërkohë që jeni të dënuar"

msgid "You can not register an account with a proxy"
msgstr "Ju nuk mund të regjistroni një llogari me një proxy"

msgid "You can not send chat messages while using a proxy"
msgstr ""
"Ju nuk mund të dërgoni mesazhe bisede ndërkohë që jeni duke përdorur një "
"proxy"

#, javascript-format
msgid ""
"You can only be owner of ${ MAX_OWNED_FACTIONS_PER_USER } factions in total"
msgstr ""
"Ti mund të jesh pronar i vetëm ${ MAX_OWNED_FACTIONS_PER_USER } fraksioneve "
"në total"

#, javascript-format
msgid "You can only have ${ MAX_FACTIONS_PER_USER } factions in total"
msgstr "Ti mund të kesh vetëm ${ MAX_FACTIONS_PER_USER } fraksione në total"

msgid ""
"You can register your own application here to get the client_id and "
"client_secret needed to make use of this."
msgstr ""
"Ju mund të regjistroni aplikacionin tuaj këtu për të marrë client_id dhe "
"client_secret që nevojiten për të përdorur këtë."

msgid "You can't send a message this long :("
msgstr "Nuk mund të dërgoni mesazh kaq të gjatë :("

msgid "You did not provide all necessary information"
msgstr "Ju nuk dhatë të gjitha informacionet e nevojshme"

msgid ""
"You do not have any email adress set. Please add one under \"Login Methods\"."
msgstr ""
"Ju nuk keni asnjë adresë emaili të caktuar. Ju lutemi shtoni një nën "
"\"Metodat e Kyçjes\"."

msgid "You don't have access to this channel"
msgstr "Ju nuk keni qasje në këtë kanal"

msgid "You failed your captcha"
msgstr "Ju keni dështuar captcha-n tuaj"

msgid "You forgot your password for PixelPlanet? Get a new one here"
msgstr "Keni harruar fjalëkalimin tuaj për PixelPlanet? Merrni një të ri këtu"

msgid "You have to fill out all fields"
msgstr "Ju duhet të plotësoni të gjitha fushat"

msgid "You must be logged in to access this page"
msgstr "Ju duhet të jeni të kyçur për të aksesuar këtë faqe"

msgid "You need an invite to join this faction"
msgstr "Ti duhet të kesh një ftesë për të hyrë në këtë fraksion"

#. "scope" is a technical term and should not be translated
msgid "You need to define a valid scope"
msgstr "Ju duhet të përcaktoni një scope të vlefshëm"

msgid "You need to directly access this page in the browser :("
msgstr ""
"Ju duhet ta aksesoni këtë faqe në shfletuesin tuaj në mënyrë direkte :("

#, javascript-format
msgid "You reached your maximum upload quota of ${ MAX_USER_MEDIA_SIZE_MB } MB"
msgstr ""
"Ju arritët kuotën tuaj maksimale të ngarkimeve prej $"
"{ MAX_USER_MEDIA_SIZE_MB } MB"

msgid ""
"You requested to get a new password. You can change your password within the "
"next 30min here: "
msgstr ""
"Ju keni kërkuar të merrni një fjalëkalim të ri. Ju mund të ndryshoni "
"fjalëkalimin tuaj brenda 30 minutave të ardhshme këtu: "

msgid "You sent an empty password or invalid data :("
msgstr "Ju keni dërguar një fjalëkalim bosh ose të dhëna të pavlefshme :("

msgid "You took too long, try again"
msgstr "Zgjatët shumë kohë, provoni përsëri"

msgid "You will be automatically redirected after 15s"
msgstr "Ju do të ridrejtoheni automatikisht pas 15 sekondash"

msgid "Your Browser looks shady"
msgstr "Shfletuesi juaj duket i dyshimtë"

msgid ""
"Your account must be at least two weeks old before you can create a faction"
msgstr ""
"Llogaria e juaj duhet të jetë të paktën 2 javë e vjetër para se të krijosh "
"një fraksion"

msgid "Your account needs to be verified to access this page"
msgstr "Llogaria juaj duhet të jetë e verifikuar për të aksesuar këtë faqe"

msgid "Your country is temporary muted from this chat channel"
msgstr "Shteti juaj është i heshtur përkohësisht nga ky kanal bisede"

msgid "Your device looks weird"
msgstr "Pajisja e juaj duket e çuditshme"

msgid "Your mail has to be verified in order to chat"
msgstr "Emaili juaj duhet të jetë i verifikuar në mënyrë që të bisedoni"

msgid ""
"Your mail verification code is invalid or already expired :(, please request "
"a new one."
msgstr ""
"Kodi juaj i verifikimit të emailit është i pavlefshëm ose ka skaduar :(, ju "
"lutemi kërkoni një të ri."

msgid "Your passwords do not match :("
msgstr "Fjalëkalimet tuaja nuk përputhen :("

